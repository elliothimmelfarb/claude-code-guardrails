{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I ~/.claude/hooks/guard-kill.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3 -I ~/.claude/hooks/check-writing.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "CHECK_REPORT_MATCH='/reports/.*\\.html$' node ~/.claude/hooks/check-report.cjs", "timeout": 60 }
        ]
      }
    ]
  }
}
